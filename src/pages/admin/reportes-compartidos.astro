---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const params = Astro.url.searchParams;
const ok = params.get("ok") === "1";
const error = params.get("error") ?? "";

const [{ data: courses }, { data: subjects }, { data: reports }] = await Promise.all([
  guard.service.from("courses").select("id,name").order("name"),
  guard.service.from("subjects").select("id,name").order("name"),
  guard.service
    .from("shared_reports")
    .select("id,token,scope_subject_id,scope_course_id,expires_at,revoked,created_at")
    .order("created_at", { ascending: false })
    .limit(200),
]);

const courseById = new Map((courses ?? []).map((c) => [c.id, c.name]));
const subjectById = new Map((subjects ?? []).map((s) => [s.id, s.name]));

const origin = Astro.url.origin;
const urlOf = (token: string) => `${origin}/r/${token}`;

function scopeLabel(r: { scope_subject_id: string | null; scope_course_id: string | null }): string {
  const parts: string[] = [];
  parts.push(r.scope_subject_id ? (subjectById.get(r.scope_subject_id) ?? "Asignatura") : "Todas las asignaturas");
  parts.push(r.scope_course_id ? (courseById.get(r.scope_course_id) ?? "Curso") : "Todos los cursos");
  return parts.join(" · ");
}

function statusOf(r: { revoked: boolean; expires_at: string | null }): { label: string; active: boolean } {
  if (r.revoked) return { label: "Revocado", active: false };
  if (r.expires_at && new Date(r.expires_at).getTime() <= Date.now()) return { label: "Vencido", active: false };
  return { label: "Activo", active: true };
}

const errorMsg =
  error === "create"
    ? "No se pudo crear el enlace. Inténtalo de nuevo."
    : error === "expiry"
      ? "Vigencia no válida. Elige una opción de la lista."
      : "";
---

<AdminLayout title="Reportes compartidos · Admin Mattics" active="reportes">
  <h1 class="text-3xl font-bold mb-2">Reportes compartidos</h1>
  <p class="text-muted-foreground mb-6">
    Crea enlaces <code>/r/TOKEN</code> para docentes: muestran solo asistencia agregada
    (conteos y nombres de presentes), sin IP, sin ubicación, sin enlaces de estudiantes
    y sin enlaces de Meet.
  </p>

  {ok && (
    <p class="rounded-lg border border-green-200 bg-green-50 text-green-800 text-sm px-4 py-2 mb-6">
      Operación realizada correctamente.
    </p>
  )}
  {errorMsg && (
    <p class="rounded-lg border border-red-200 bg-red-50 text-red-800 text-sm px-4 py-2 mb-6">
      {errorMsg}
    </p>
  )}

  <form method="POST" action="/api/admin/reportes-compartidos" class="rounded-xl border border-border bg-card p-5 mb-8 grid gap-3 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end">
    <input type="hidden" name="action" value="create" />
    <div>
      <label class="text-sm font-medium block mb-1" for="scope_subject_id">Asignatura</label>
      <select id="scope_subject_id" name="scope_subject_id" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Todas</option>
        {(subjects ?? []).map((s) => (<option value={s.id}>{s.name}</option>))}
      </select>
    </div>
    <div>
      <label class="text-sm font-medium block mb-1" for="scope_course_id">Curso</label>
      <select id="scope_course_id" name="scope_course_id" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Todos</option>
        {(courses ?? []).map((c) => (<option value={c.id}>{c.name}</option>))}
      </select>
    </div>
    <div>
      <label class="text-sm font-medium block mb-1" for="expiry_days">Vigencia</label>
      <select id="expiry_days" name="expiry_days" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="7">7 días</option>
        <option value="15">15 días</option>
        <option value="30">30 días</option>
        <option value="90">90 días</option>
        <option value="">Sin vencimiento</option>
      </select>
    </div>
    <div>
      <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">
        Crear enlace
      </button>
    </div>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr>
          <th class="text-left px-4 py-2">Alcance</th>
          <th class="text-left px-4 py-2">Enlace</th>
          <th class="text-left px-4 py-2">Vence</th>
          <th class="text-left px-4 py-2">Estado</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {(reports ?? []).map((r) => {
          const url = urlOf(r.token);
          const st = statusOf(r);
          return (
            <tr class="border-t border-border">
              <td class="px-4 py-2">{scopeLabel(r)}</td>
              <td class="px-4 py-2 max-w-xs truncate text-muted-foreground">{url}</td>
              <td class="px-4 py-2 whitespace-nowrap text-muted-foreground">
                {r.expires_at ? new Date(r.expires_at).toLocaleDateString("es-CO") : "Sin vencimiento"}
              </td>
              <td class="px-4 py-2">
                <span class:list={[
                  "text-xs px-2 py-0.5 rounded-full border",
                  st.active
                    ? "border-green-200 bg-green-50 text-green-800"
                    : "border-border bg-muted text-muted-foreground",
                ]}>
                  {st.label}
                </span>
              </td>
              <td class="px-4 py-2 text-right whitespace-nowrap">
                {st.active && (
                  <button type="button" data-copy={url} class="text-sm text-primary hover:underline mr-3">Copiar</button>
                )}
                {!r.revoked && (
                  <form method="POST" action="/api/admin/reportes-compartidos" class="inline">
                    <input type="hidden" name="action" value="revoke" />
                    <input type="hidden" name="id" value={r.id} />
                    <button
                      type="submit"
                      onclick="return confirm('¿Revocar este enlace? Dejará de funcionar de inmediato.')"
                      class="text-sm text-muted-foreground hover:underline"
                    >
                      Revocar
                    </button>
                  </form>
                )}
              </td>
            </tr>
          );
        })}
        {(reports ?? []).length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-center text-muted-foreground">Aún no hay enlaces. Crea el primero arriba.</td></tr>
        )}
      </tbody>
    </table>
  </div>

  <script is:inline>
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-copy]");
      if (!btn) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        btn.textContent = "¡Copiado!";
        setTimeout(() => (btn.textContent = "Copiar"), 1500);
      } catch {
        btn.textContent = "Error";
      }
    });
  </script>
</AdminLayout>
