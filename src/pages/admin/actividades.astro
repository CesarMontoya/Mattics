---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";
import { listSessions } from "@/lib/actividad/store";
import { formatFecha } from "@/lib/clases/fecha";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const sessions = await listSessions();
const { data: courses } = await guard.service
  .from("courses")
  .select("id,name")
  .order("name", { ascending: true });

const params = Astro.url.searchParams;
const ok = params.get("ok");
const err = params.get("error");
const detail = params.get("detail");
const origin = Astro.url.origin;

const totalEntregas = sessions.reduce((sum, session) => sum + session.submissions, 0);
---

<AdminLayout title="Actividades · Admin Mattics" active="actividades">
  <h1 class="text-3xl font-bold mb-2">Actividades</h1>
  <p class="text-sm text-muted-foreground mb-6">
    Crea una clase, comparte el código y revisa las entregas de tus estudiantes.
  </p>

  {ok && <p class="text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2 mb-4">Guardado correctamente.</p>}
  {err && <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mb-4">No se pudo guardar (código: {err}{detail ? `: ${detail}` : ""}).</p>}

  <form method="POST" action="/api/admin/actividades" class="rounded-xl border border-border bg-card p-5 mb-8 flex flex-col sm:flex-row gap-3 sm:items-end">
    <div class="flex-1">
      <label for="title" class="text-sm font-medium block mb-1">Nombre de la clase</label>
      <input id="title" name="title" required maxlength="120" placeholder="Economía 7-B · martes"
        class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <div class="sm:w-56">
      <label for="course_id" class="text-sm font-medium block mb-1">Curso (opcional)</label>
      <select id="course_id" name="course_id" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Sin curso</option>
        {(courses ?? []).map((course) => (
          <option value={course.id}>{course.name}</option>
        ))}
      </select>
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">
      Crear clase
    </button>
  </form>

  <div class="flex items-baseline justify-between mb-3">
    <h2 class="text-lg font-semibold">Clases</h2>
    <p class="text-sm text-muted-foreground">{sessions.length} clases · {totalEntregas} entregas</p>
  </div>

  {sessions.length === 0 ? (
    <div class="rounded-xl border border-dashed border-border p-8 text-center text-muted-foreground">
      Todavía no hay clases. Crea la primera arriba.
    </div>
  ) : (
    <div class="grid gap-3">
      {sessions.map((session) => {
        const link = `${origin}/e/${session.code}`;
        return (
          <article class="rounded-xl border border-border bg-card p-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="font-semibold text-lg">{session.title}</h3>
                  {session.closed_at
                    ? <span class="text-xs rounded-full bg-red-50 text-red-700 border border-red-200 px-2 py-0.5">Cerrada</span>
                    : <span class="text-xs rounded-full bg-green-50 text-green-700 border border-green-200 px-2 py-0.5">Abierta</span>}
                </div>
                <p class="text-xs text-muted-foreground mt-1">
                  Creada el {formatFecha(session.created_at)} · {session.submissions} {session.submissions === 1 ? "entrega" : "entregas"}
                </p>
              </div>

              <div class="flex items-center gap-4">
                <div class="text-center">
                  <p class="text-[11px] uppercase tracking-wide text-muted-foreground">Código</p>
                  <p class="font-mono text-2xl font-bold tracking-[0.2em]">{session.code}</p>
                </div>
                <a href={link} class="text-sm text-blue-600 hover:underline break-all">{link}</a>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
              <a href={`/admin/actividades/${session.id}`} class="rounded-lg border border-border px-3 py-1.5 text-sm hover:bg-muted">Ver entregas</a>
              <button type="button" data-copy={session.code} class="rounded-lg border border-border px-3 py-1.5 text-sm hover:bg-muted">
                Copiar código
              </button>
              <button type="button" data-copy={link} class="rounded-lg border border-border px-3 py-1.5 text-sm hover:bg-muted">
                Copiar enlace
              </button>
              <form method="POST" action="/api/admin/actividades" class="inline">
                <input type="hidden" name="id" value={session.id} />
                <input type="hidden" name="action" value={session.closed_at ? "reopen" : "close"} />
                <button type="submit" class="text-sm text-amber-700 hover:underline">
                  {session.closed_at ? "Reabrir" : "Cerrar"}
                </button>
              </form>
              <form method="POST" action="/api/admin/actividades" class="inline ml-auto">
                <input type="hidden" name="id" value={session.id} />
                <input type="hidden" name="action" value="delete" />
                <button type="submit" onclick="return confirm('¿Eliminar esta clase y todas sus entregas? No se puede deshacer.')"
                  class="text-sm text-red-600 hover:underline">Eliminar</button>
              </form>
            </div>
          </article>
        );
      })}
    </div>
  )}

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const value = button.dataset.copy ?? "";
        try {
          await navigator.clipboard.writeText(value);
          const original = button.textContent;
          button.textContent = "Copiado";
          setTimeout(() => { button.textContent = original; }, 1500);
        } catch {
          window.prompt("Copia el valor:", value);
        }
      });
    });
  </script>
</AdminLayout>
