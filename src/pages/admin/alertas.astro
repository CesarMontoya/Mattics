---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";
import { shortTime } from "@/lib/clases/admin";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const params = Astro.url.searchParams;
const fCurso = params.get("curso") ?? "";
const fAsignatura = params.get("asignatura") ?? "";
const fDia = params.get("dia") ?? "";
const fClase = params.get("clase") ?? "";

const [{ data: courses }, { data: subjects }, { data: schedules }] = await Promise.all([
  guard.service.from("courses").select("id,name").order("name"),
  guard.service.from("subjects").select("id,name").order("name"),
  guard.service.from("schedules").select("id,weekday,start_time,end_time").order("weekday").order("start_time"),
]);

function firstOf(v: unknown) {
  return Array.isArray(v) ? v[0] : v;
}

function schedLabel(id: unknown) {
  if (typeof id !== "string" || !id) return "—";
  const s = (schedules ?? []).find((x) => x.id === id);
  return s ? `d${s.weekday} ${shortTime(s.start_time)}–${shortTime(s.end_time)}` : id.slice(0, 8);
}

function toRow(a: any) {
  const v = firstOf(a.visits);
  const st = v ? firstOf(v.students) : null;
  return {
    hora: v?.occurred_at ? new Date(v.occurred_at).toLocaleString("es-CO") : "—",
    estudiante: st?.full_name ?? "—",
    ip: v?.ip ?? "—",
    clase: schedLabel(v?.resolved_schedule_id),
    detalle: JSON.stringify(a.details),
  };
}

async function fetchAlerts(severity: "high" | "moderate") {
  let q = guard.service
    .from("alerts")
    .select("id,type,severity,created_at,details,visits(id,occurred_at,ip,student_id,resolved_course_id,resolved_subject_id,resolved_schedule_id,students(id,full_name))")
    .eq("severity", severity)
    .order("created_at", { ascending: false })
    .limit(200);
  if (fClase) q = q.eq("visits.resolved_schedule_id", fClase);
  const { data } = await q;
  let rows = (data ?? []) as any[];
  if (fCurso) rows = rows.filter((a) => firstOf(a.visits)?.resolved_course_id === fCurso);
  if (fAsignatura) rows = rows.filter((a) => firstOf(a.visits)?.resolved_subject_id === fAsignatura);
  if (fDia) rows = rows.filter((a) => (firstOf(a.visits)?.occurred_at ?? "").startsWith(fDia));
  return rows.map(toRow);
}

const [high, moderate] = await Promise.all([fetchAlerts("high"), fetchAlerts("moderate")]);
---

<AdminLayout title="Alertas · Admin Mattics" active="alertas">
  <h1 class="text-3xl font-bold mb-6">Alertas</h1>

  <form method="GET" class="rounded-xl border border-border bg-card p-5 mb-8 grid gap-3 sm:grid-cols-[1fr_1fr_1fr_1fr_auto] sm:items-end">
    <div>
      <label class="text-sm font-medium block mb-1" for="curso">Curso</label>
      <select id="curso" name="curso" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Todos</option>
        {(courses ?? []).map((c) => (<option value={c.id} selected={c.id === fCurso}>{c.name}</option>))}
      </select>
    </div>
    <div>
      <label class="text-sm font-medium block mb-1" for="asignatura">Asignatura</label>
      <select id="asignatura" name="asignatura" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Todas</option>
        {(subjects ?? []).map((s) => (<option value={s.id} selected={s.id === fAsignatura}>{s.name}</option>))}
      </select>
    </div>
    <div>
      <label class="text-sm font-medium block mb-1" for="dia">Día</label>
      <input id="dia" name="dia" type="date" value={fDia} class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-sm font-medium block mb-1" for="clase">Clase</label>
      <select id="clase" name="clase" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Todas</option>
        {(schedules ?? []).map((s) => (
          <option value={s.id} selected={s.id === fClase}>d{s.weekday} {shortTime(s.start_time)}–{shortTime(s.end_time)}</option>
        ))}
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Filtrar</button>
      <a href="/admin/alertas" class="rounded-lg border border-border px-4 py-2 text-sm">Limpiar</a>
    </div>
  </form>

  <h2 class="text-xl font-semibold mb-3 text-red-700">Alta — IP diferente ({high.length})</h2>
  <div class="rounded-xl border border-red-200 overflow-x-auto mb-10">
    <table class="w-full text-sm min-w-[760px]">
      <thead class="bg-red-50">
        <tr><th class="text-left px-4 py-2">Hora</th><th class="text-left px-4 py-2">Estudiante</th><th class="text-left px-4 py-2">IP</th><th class="text-left px-4 py-2">Clase</th><th class="text-left px-4 py-2">Detalle</th></tr>
      </thead>
      <tbody>
        {high.map((a) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2 whitespace-nowrap">{a.hora}</td>
            <td class="px-4 py-2 font-medium">{a.estudiante}</td>
            <td class="px-4 py-2">{a.ip}</td>
            <td class="px-4 py-2">{a.clase}</td>
            <td class="px-4 py-2 text-muted-foreground max-w-xs truncate">{a.detalle}</td>
          </tr>
        ))}
        {high.length === 0 && (<tr><td colspan="5" class="px-4 py-6 text-center text-muted-foreground">Sin alertas altas.</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2 class="text-xl font-semibold mb-3 text-amber-700">Moderada — mismo IP repetido ({moderate.length})</h2>
  <div class="rounded-xl border border-amber-200 overflow-x-auto">
    <table class="w-full text-sm min-w-[760px]">
      <thead class="bg-amber-50">
        <tr><th class="text-left px-4 py-2">Hora</th><th class="text-left px-4 py-2">Estudiante</th><th class="text-left px-4 py-2">IP</th><th class="text-left px-4 py-2">Clase</th><th class="text-left px-4 py-2">Detalle</th></tr>
      </thead>
      <tbody>
        {moderate.map((a) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2 whitespace-nowrap">{a.hora}</td>
            <td class="px-4 py-2 font-medium">{a.estudiante}</td>
            <td class="px-4 py-2">{a.ip}</td>
            <td class="px-4 py-2">{a.clase}</td>
            <td class="px-4 py-2 text-muted-foreground max-w-xs truncate">{a.detalle}</td>
          </tr>
        ))}
        {moderate.length === 0 && (<tr><td colspan="5" class="px-4 py-6 text-center text-muted-foreground">Sin alertas moderadas.</td></tr>)}
      </tbody>
    </table>
  </div>
</AdminLayout>
