---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const [{ data: teachers }, { data: links }, { data: schedules }] = await Promise.all([
  guard.service.from("teachers").select("id,full_name,created_at").order("full_name"),
  guard.service.from("subject_meet_links").select("teacher_id,subjects(id,name)").order("created_at"),
  guard.service.from("schedules").select("teacher_id"),
]);

const subjectName = (l: { subjects: unknown }) => {
  const s = Array.isArray(l.subjects) ? l.subjects[0] : (l.subjects as { name?: string } | null);
  return s?.name ?? null;
};

const subjectsOf = (teacherId: string) => {
  const names = new Set<string>();
  for (const l of links ?? []) {
    if ((l as { teacher_id: string | null }).teacher_id === teacherId) {
      const n = subjectName(l);
      if (n) names.add(n);
    }
  }
  return [...names].sort((a, b) => a.localeCompare(b, "es"));
};
const franjasOf = (teacherId: string) =>
  (schedules ?? []).filter((s) => (s as { teacher_id: string | null }).teacher_id === teacherId).length;

const params = Astro.url.searchParams;
const ok = params.get("ok");
const err = params.get("error");
---

<AdminLayout title="Docentes · Admin Mattics" active="docentes">
  <h1 class="text-3xl font-bold mb-6">Docentes</h1>

  {ok && <p class="text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2 mb-4">Guardado correctamente.</p>}
  {err && <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mb-4">No se pudo guardar (código: {err}).</p>}

  <form method="POST" action="/api/admin/docentes" class="rounded-xl border border-border bg-card p-5 mb-8 flex flex-col sm:flex-row gap-3 sm:items-end">
    <div class="flex-1">
      <label for="full_name" class="text-sm font-medium block mb-1">Nuevo docente (ej. JOHANA)</label>
      <input id="full_name" name="full_name" required maxlength="100" placeholder="Nombre del docente"
        class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Crear</button>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr>
          <th class="text-left px-4 py-2">Docente</th>
          <th class="text-left px-4 py-2">Asignaturas vinculadas</th>
          <th class="text-right px-4 py-2">Franjas</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {(teachers ?? []).map((t) => {
          const subs = subjectsOf(t.id);
          return (
            <tr class="border-t border-border">
              <td class="px-4 py-2 font-medium">{t.full_name}</td>
              <td class="px-4 py-2 text-muted-foreground">{subs.length > 0 ? subs.join(", ") : "—"}</td>
              <td class="px-4 py-2 text-right text-muted-foreground">{franjasOf(t.id)}</td>
              <td class="px-4 py-2 text-right">
                <form method="POST" action="/api/admin/docentes" class="inline">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={t.id} />
                  <button type="submit" onclick="return confirm('¿Eliminar este docente? Sus franjas y enlaces quedarán sin docente asignado.')" class="text-sm text-red-600 hover:underline">Eliminar</button>
                </form>
              </td>
            </tr>
          );
        })}
        {(teachers ?? []).length === 0 && (
          <tr><td colspan="4" class="px-4 py-6 text-center text-muted-foreground">Sin docentes todavía.</td></tr>
        )}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm text-muted-foreground">
    Para asignar un docente a una asignatura, crea o edita su enlace en{" "}
    <a href="/admin/enlaces-meet" class="text-primary hover:underline">Enlaces Meet</a>{" "}
    eligiendo el docente, o guárdalo desde el{" "}
    <a href="/admin/horarios" class="text-primary hover:underline">planificador de horarios</a>.
  </p>
</AdminLayout>
