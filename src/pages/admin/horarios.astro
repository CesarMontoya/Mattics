---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";
import { WEEKDAY_OPTIONS, weekdayLabel, shortTime } from "@/lib/clases/admin";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const [{ data: courses }, { data: subjects }, { data: schedules }] = await Promise.all([
  guard.service.from("courses").select("id,name").order("name"),
  guard.service.from("subjects").select("id,name").order("name"),
  guard.service.from("schedules").select("id,course_id,subject_id,weekday,start_time,end_time,courses(id,name),subjects(id,name)").order("weekday").order("start_time"),
]);

const nameOf = (row: { courses: unknown }, key: "courses" | "subjects") => {
  const v = (row as Record<string, unknown>)[key];
  const o = Array.isArray(v) ? v[0] : (v as { name?: string } | null);
  return o?.name ?? "—";
};
---

<AdminLayout title="Horarios · Admin Mattics" active="horarios">
  <h1 class="text-3xl font-bold mb-6">Horarios</h1>

  <form method="POST" action="/api/admin/horarios" class="rounded-xl border border-border bg-card p-5 mb-8 grid gap-3 sm:grid-cols-[1fr_1fr_1fr_1fr_1fr_auto] sm:items-end">
    <div>
      <label for="course_id" class="text-sm font-medium block mb-1">Curso</label>
      <select id="course_id" name="course_id" required class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Seleccionar…</option>
        {(courses ?? []).map((c) => (<option value={c.id}>{c.name}</option>))}
      </select>
    </div>
    <div>
      <label for="subject_id" class="text-sm font-medium block mb-1">Asignatura</label>
      <select id="subject_id" name="subject_id" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Sin asignatura</option>
        {(subjects ?? []).map((s) => (<option value={s.id}>{s.name}</option>))}
      </select>
    </div>
    <div>
      <label for="weekday" class="text-sm font-medium block mb-1">Día (0=Dom … 6=Sáb)</label>
      <select id="weekday" name="weekday" required class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        {WEEKDAY_OPTIONS.map((w) => (<option value={w.value}>{w.value} · {w.label}</option>))}
      </select>
    </div>
    <div>
      <label for="start_time" class="text-sm font-medium block mb-1">Inicio</label>
      <input id="start_time" name="start_time" type="time" required class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="end_time" class="text-sm font-medium block mb-1">Fin</label>
      <input id="end_time" name="end_time" type="time" required class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Crear</button>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr>
          <th class="text-left px-4 py-2">Curso</th><th class="text-left px-4 py-2">Asignatura</th>
          <th class="text-left px-4 py-2">Día</th><th class="text-left px-4 py-2">Hora</th><th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {(schedules ?? []).map((s) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2 font-medium">{nameOf(s, "courses")}</td>
            <td class="px-4 py-2">{nameOf(s, "subjects")}</td>
            <td class="px-4 py-2">{weekdayLabel(s.weekday)} ({s.weekday})</td>
            <td class="px-4 py-2 text-muted-foreground">{shortTime(s.start_time)} – {shortTime(s.end_time)}</td>
            <td class="px-4 py-2 text-right">
              <form method="POST" action="/api/admin/horarios" class="inline">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={s.id} />
                <button type="submit" onclick="return confirm('¿Eliminar este horario?')" class="text-sm text-red-600 hover:underline">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
        {(schedules ?? []).length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-center text-muted-foreground">Sin horarios todavía.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
