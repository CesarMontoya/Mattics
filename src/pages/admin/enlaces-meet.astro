---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const [{ data: subjects }, { data: teachers }, { data: links }] = await Promise.all([
  guard.service.from("subjects").select("id,name").order("name"),
  guard.service.from("teachers").select("id,full_name").order("full_name"),
  guard.service.from("subject_meet_links").select("id,url,label,subject_id,created_at,subjects(id,name),teachers(id,full_name)").order("created_at", { ascending: false }),
]);

const subjectName = (l: { subjects: unknown }) => {
  const s = Array.isArray(l.subjects) ? l.subjects[0] : (l.subjects as { name?: string } | null);
  return s?.name ?? "—";
};
const teacherName = (l: { teachers: unknown }) => {
  const t = Array.isArray(l.teachers) ? l.teachers[0] : (l.teachers as { full_name?: string } | null);
  return t?.full_name ?? "—";
};

const params = Astro.url.searchParams;
const ok = params.get("ok");
const err = params.get("error");
const detail = params.get("detail");
---

<AdminLayout title="Enlaces Meet · Admin Mattics" active="meet">
  <h1 class="text-3xl font-bold mb-6">Enlaces Meet</h1>

  {ok && <p class="text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2 mb-4">Guardado correctamente.</p>}
  {err && <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mb-4">No se pudo completar (código: {err}{detail ? `: ${detail}` : ""}).</p>}
  <p class="text-sm text-muted-foreground mb-4">Solo se aceptan URL que comiencen con <code>https://meet.google.com/</code>.</p>

  <form method="POST" action="/api/admin/enlaces-meet" class="rounded-xl border border-border bg-card p-5 mb-8 grid gap-3 sm:grid-cols-[1fr_1fr_2fr_1fr_auto] sm:items-end">
    <div>
      <label for="subject_id" class="text-sm font-medium block mb-1">Asignatura</label>
      <select id="subject_id" name="subject_id" required class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Seleccionar…</option>
        {(subjects ?? []).map((s) => (<option value={s.id}>{s.name}</option>))}
      </select>
    </div>
    <div>
      <label for="teacher_id" class="text-sm font-medium block mb-1">Docente (opcional)</label>
      <select id="teacher_id" name="teacher_id" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm">
        <option value="">Sin docente</option>
        {(teachers ?? []).map((t) => (<option value={t.id}>{t.full_name}</option>))}
      </select>
    </div>
    <div>
      <label for="url" class="text-sm font-medium block mb-1">URL de Meet</label>
      <input id="url" name="url" type="url" required placeholder="https://meet.google.com/xxx-xxxx-xxx"
        pattern="https://meet\\.google\\.com/.*" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="label" class="text-sm font-medium block mb-1">Etiqueta (opcional)</label>
      <input id="label" name="label" maxlength="100" placeholder="Grupo A"
        class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Crear</button>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr><th class="text-left px-4 py-2">Asignatura</th><th class="text-left px-4 py-2">Docente</th><th class="text-left px-4 py-2">URL</th><th class="text-left px-4 py-2">Etiqueta</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {(links ?? []).map((l) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2 font-medium">{subjectName(l)}</td>
            <td class="px-4 py-2 text-muted-foreground">{teacherName(l)}</td>
            <td class="px-4 py-2 text-muted-foreground">
              <span class="flex items-center gap-2 min-w-0">
                <a href={l.url} target="_blank" rel="noopener" class="text-primary hover:underline break-all">{l.url}</a>
                <button
                  type="button"
                  data-copy={l.url}
                  class="no-print shrink-0 rounded-lg border border-border px-2 py-1 text-xs hover:bg-muted"
                  onclick="navigator.clipboard?.writeText(this.dataset.copy).then(()=>{this.textContent='¡Copiado!';setTimeout(()=>this.textContent='Copiar',1500);}).catch(()=>{this.textContent='Error';})"
                >Copiar</button>
              </span>
            </td>
            <td class="px-4 py-2 text-muted-foreground">{l.label ?? "—"}</td>
            <td class="px-4 py-2 text-right">
              <form method="POST" action="/api/admin/enlaces-meet" class="inline">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={l.id} />
                <button type="submit" onclick="return confirm('¿Eliminar este enlace?')" class="text-sm text-red-600 hover:underline">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
        {(links ?? []).length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-center text-muted-foreground">Sin enlaces todavía.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
