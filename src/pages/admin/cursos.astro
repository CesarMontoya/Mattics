---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const { data: courses } = await guard.service
  .from("courses")
  .select("id,name,created_at")
  .order("created_at", { ascending: false });

const params = Astro.url.searchParams;
const ok = params.get("ok");
const err = params.get("error");
const detail = params.get("detail");
---

<AdminLayout title="Cursos · Admin Mattics" active="cursos">
  <h1 class="text-3xl font-bold mb-6">Cursos</h1>

  {ok && <p class="text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2 mb-4">Guardado correctamente.</p>}
  {err && <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2 mb-4">No se pudo guardar (código: {err}{detail ? `: ${detail}` : ""}).</p>}

  <form method="POST" action="/api/admin/cursos" class="rounded-xl border border-border bg-card p-5 mb-8 flex flex-col sm:flex-row gap-3 sm:items-end">
    <div class="flex-1">
      <label for="name" class="text-sm font-medium block mb-1">Nuevo curso (ej. 10-A)</label>
      <input id="name" name="name" required maxlength="100" placeholder="Nombre del curso"
        class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Crear</button>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr><th class="text-left px-4 py-2">Nombre</th><th class="text-left px-4 py-2">Creado</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {(courses ?? []).map((c) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2 font-medium">{c.name}</td>
            <td class="px-4 py-2 text-muted-foreground">{new Date(c.created_at).toLocaleDateString("es-CO")}</td>
            <td class="px-4 py-2 text-right">
              <form method="POST" action="/api/admin/cursos" class="inline">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={c.id} />
                <button type="submit" onclick="return confirm('¿Eliminar este curso?')" class="text-sm text-red-600 hover:underline">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
        {(courses ?? []).length === 0 && (
          <tr><td colspan="3" class="px-4 py-6 text-center text-muted-foreground">Sin cursos todavía.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
