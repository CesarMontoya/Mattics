---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { requireAdminPage } from "@/lib/clases/guard";

const guard = await requireAdminPage(Astro);
if (!guard) return Astro.redirect("/admin/login", 302);

const { data: subjects } = await guard.service
  .from("subjects")
  .select("id,name,created_at")
  .order("name");
---

<AdminLayout title="Asignaturas · Admin Mattics" active="asignaturas">
  <h1 class="text-3xl font-bold mb-6">Asignaturas</h1>

  <form method="POST" action="/api/admin/asignaturas" class="rounded-xl border border-border bg-card p-5 mb-8 flex flex-col sm:flex-row gap-3 sm:items-end">
    <div class="flex-1">
      <label for="name" class="text-sm font-medium block mb-1">Nueva asignatura (ej. Matemáticas)</label>
      <input id="name" name="name" required maxlength="100" placeholder="Nombre de la asignatura"
        class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm" />
    </div>
    <input type="hidden" name="action" value="create" />
    <button type="submit" class="rounded-lg bg-primary text-primary-foreground px-4 py-2 text-sm font-medium">Crear</button>
  </form>

  <div class="rounded-xl border border-border overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted">
        <tr><th class="text-left px-4 py-2">Nombre</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody>
        {(subjects ?? []).map((s) => (
          <tr class="border-t border-border">
            <td class="px-4 py-2">
              <form method="POST" action="/api/admin/asignaturas" class="flex gap-2 items-center">
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" value={s.id} />
                <input name="name" value={s.name} maxlength="100" required
                  class="rounded border border-input bg-background px-2 py-1 text-sm w-56" />
                <button type="submit" class="text-sm text-primary hover:underline">Guardar</button>
              </form>
            </td>
            <td class="px-4 py-2 text-right">
              <form method="POST" action="/api/admin/asignaturas" class="inline">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={s.id} />
                <button type="submit" onclick="return confirm('¿Eliminar esta asignatura?')" class="text-sm text-red-600 hover:underline">Eliminar</button>
              </form>
            </td>
          </tr>
        ))}
        {(subjects ?? []).length === 0 && (
          <tr><td colspan="2" class="px-4 py-6 text-center text-muted-foreground">Sin asignaturas todavía.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
