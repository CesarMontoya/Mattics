---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import { createSupabaseServiceRoleClient } from "@/lib/supabase/server";
import { hourLabel12, timeRange12 } from "@/lib/clases/admin";
import { resolveScheduleFor, getBogotaParts, WEEKDAY_NAMES_ES, type Resolution } from "@/lib/clases/resolve";
import { getClientIp, fetchIpGeo, parseUserAgent } from "@/lib/clases/telemetry";

type LinkContext = {
  studentLinkId: string;
  studentId: string;
  studentName: string;
  courseId: string | null;
  courseName: string | null;
};

const token = (Astro.params.token ?? "").trim();

let invalid = false;
let context: LinkContext | null = null;
let resolution: Resolution | null = null;

function shortTime(t: string | null | undefined): string {
  if (!t) return "";
  return t.slice(0, 5);
}

function weekdayEs(weekday: number): string {
  return WEEKDAY_NAMES_ES[weekday] ?? "";
}

// --- Server-side lookup + tracking (service-role only, never leaks Meet URL) ---
if (!token) {
  invalid = true;
} else {
  try {
    const supabase = createSupabaseServiceRoleClient();

    const { data: link, error: linkError } = await supabase
      .from("student_links")
      .select("id,student_id")
      .eq("token", token)
      .maybeSingle();

    if (linkError || !link) {
      invalid = true;
    } else {
      const { data: student, error: studentError } = await supabase
        .from("students")
        .select("id,full_name,course_id,courses(id,name)")
        .eq("id", link.student_id)
        .maybeSingle();

      if (studentError || !student) {
        invalid = true;
      } else {
        const course = Array.isArray(student.courses) ? student.courses[0] : student.courses;
        context = {
          studentLinkId: link.id as string,
          studentId: student.id as string,
          studentName: (student.full_name as string) ?? "Estudiante",
          courseId: (student.course_id as string | null) ?? (course?.id as string | undefined) ?? null,
          courseName: (course?.name as string | undefined) ?? null,
        };

        // Resolve current/next class in America/Bogota.
        if (context.courseId) {
          try {
            resolution = await resolveScheduleFor(context.courseId, new Date());
          } catch (err) {
            console.error("[ir] resolveScheduleFor failed:", err);
            resolution = null;
          }
        }

        // Best-effort visit tracking — must never block the redirect/waiting page.
        try {
          const headers = Astro.request.headers;
          const ip = getClientIp(Astro.clientAddress, headers);
          const geo = await fetchIpGeo(ip);
          const uaRaw = headers.get("user-agent");
          const uaShort = parseUserAgent(uaRaw);
          const nowIso = new Date().toISOString();

          const resolvedCurrent = resolution?.schedule ?? resolution?.nextClass?.schedule ?? null;
          const resolvedSubjectId =
            resolution?.subject?.id ?? resolution?.nextClass?.subject?.id ?? null;

          // Alert history is read BEFORE inserting the current visit, so the
          // comparison is strictly against previous visits (last 30 days).
          const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
          let priorIps: string[] = [];
          try {
            const { data: recent } = await supabase
              .from("visits")
              .select("ip")
              .eq("student_link_id", context.studentLinkId)
              .gte("occurred_at", thirtyDaysAgo)
              .order("occurred_at", { ascending: false })
              .limit(50);
            priorIps = [
              ...new Set(
                ((recent ?? []) as Array<{ ip: string | null }>)
                  .map((r) => r.ip)
                  .filter((v): v is string => typeof v === "string" && v.length > 0),
              ),
            ];
          } catch (err) {
            console.error("[ir] recent visits lookup failed:", err);
          }

          const { data: visit, error: visitError } = await supabase
            .from("visits")
            .insert({
              student_link_id: context.studentLinkId,
              student_id: context.studentId,
              occurred_at: nowIso,
              ip,
              ip_city: geo.city,
              ip_country: geo.country,
              user_agent: uaRaw ?? uaShort,
              resolved_course_id: context.courseId,
              resolved_subject_id: resolvedSubjectId,
              resolved_schedule_id: resolvedCurrent?.id ?? null,
            })
            .select("id")
            .single();

          if (!visitError && visit) {
            if (ip && priorIps.length > 0) {
              const alert = priorIps.includes(ip)
                ? { type: "same_ip_repeat", severity: "moderate" }
                : { type: "different_ip", severity: "high" };
              const { error: alertError } = await supabase.from("alerts").insert({
                visit_id: (visit as { id: string }).id,
                type: alert.type,
                severity: alert.severity,
                details: { ip, previousIps: priorIps, userAgent: uaShort },
              });
              if (alertError) console.error("[ir] alert insert failed:", alertError.message);
            }

            // Detección de accesos simultáneos: otra visita del mismo enlace en
            // los últimos 20 minutos con IP o user_agent distinto (posible
            // enlace compartido). Best-effort: nunca bloquea la redirección.
            try {
              const currentId = (visit as { id: string }).id;
              const currentUa = uaRaw ?? uaShort;
              const windowStart = new Date(Date.now() - 20 * 60 * 1000).toISOString();
              const { data: recentWindow } = await supabase
                .from("visits")
                .select("id,ip,ip_city,user_agent,occurred_at")
                .eq("student_link_id", context.studentLinkId)
                .neq("id", currentId)
                .gte("occurred_at", windowStart)
                .order("occurred_at", { ascending: false })
                .limit(10);
              const match = ((recentWindow ?? []) as Array<{
                id: string;
                ip: string | null;
                ip_city: string | null;
                user_agent: string | null;
                occurred_at: string;
              }>).find((v) => v.ip !== ip || v.user_agent !== currentUa);
              if (match) {
                const deltaSeconds = Math.max(
                  0,
                  Math.round(
                    (new Date(nowIso).getTime() - new Date(match.occurred_at).getTime()) / 1000,
                  ),
                );
                const { error: simError } = await supabase.from("alerts").insert({
                  visit_id: currentId,
                  type: "simultaneous",
                  severity: "high",
                  details: {
                    current_visit_id: currentId,
                    current_ip: ip,
                    current_city: geo.city,
                    current_user_agent: currentUa,
                    matched_visit_id: match.id,
                    matched_ip: match.ip,
                    matched_city: match.ip_city,
                    matched_user_agent: match.user_agent,
                    delta_seconds: deltaSeconds,
                    window_minutes: 20,
                  },
                });
                if (simError) console.error("[ir] simultaneous alert failed:", simError.message);
              }
            } catch (err) {
              console.error("[ir] simultaneous check failed:", err);
            }
          } else if (visitError) {
            console.error("[ir] visit insert failed:", visitError.message);
          }
        } catch (err) {
          console.error("[ir] telemetry failed:", err);
        }
      }
    }
  } catch (err) {
    console.error("[ir] lookup failed:", err);
    invalid = true;
  }
}

// Redirect only when a live class with a Meet URL was resolved.
if (!invalid && resolution?.meetUrl) {
  return Astro.redirect(resolution.meetUrl, 302);
}

const pageTitle = invalid ? "Enlace no válido | Mattics" : "Tu clase virtual | Mattics";
const next = resolution?.nextClass ?? null;

// --- Horario semanal del curso (solo lectura, sin edición) ---
type WeekBlock = {
  subject: string;
  teacher: string;
  time: string;
  top: number;
  height: number;
  isNext: boolean;
};
type WeekDay = { weekday: number; label: string; isToday: boolean; blocks: WeekBlock[] };

const CAL_DAYS = [1, 2, 3, 4, 5]; // Lunes a Viernes
const CAL_START_MIN = 12 * 60;
const CAL_END_MIN = 18 * 60;
const PX_PER_HOUR = 48;
const CAL_HEIGHT = ((CAL_END_MIN - CAL_START_MIN) / 60) * PX_PER_HOUR;
const calHours: number[] = [];
for (let h = 12; h < 18; h++) calHours.push(h);

function joinName(v: unknown): string | null {
  const o = Array.isArray(v) ? v[0] : (v as { name?: string; full_name?: string } | null);
  return o?.name ?? o?.full_name ?? null;
}
function toMinutes(t: string): number {
  return Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
}

let weekDays: WeekDay[] = [];
let nextTeacher: string | null = null;

if (!invalid && context?.courseId) {
  try {
    const supabase2 = createSupabaseServiceRoleClient();
    const schedRes = await supabase2
      .from("schedules")
      .select("id,weekday,start_time,end_time,subjects(id,name),teachers(id,full_name)")
      .eq("course_id", context.courseId)
      .order("weekday")
      .order("start_time");
    const rows = (schedRes.data ?? []) as Array<{
      id: string;
      weekday: number;
      start_time: string;
      end_time: string;
      subjects: unknown;
      teachers: unknown;
    }>;
    const todayWd = getBogotaParts(new Date()).weekday;
    const nextId = next?.schedule?.id ?? null;
    weekDays = CAL_DAYS.map((wd) => {
      const dayName = WEEKDAY_NAMES_ES[wd] ?? "";
      const blocks: WeekBlock[] = [];
      for (const r of rows) {
        if (r.weekday !== wd) continue;
        const startMin = toMinutes(r.start_time);
        const endMin = toMinutes(r.end_time);
        if (r.id === nextId) nextTeacher = joinName(r.teachers);
        blocks.push({
          subject: joinName(r.subjects) ?? "Clase",
          teacher: joinName(r.teachers) ?? "—",
          time: timeRange12(r.start_time, r.end_time),
          top: Math.max(0, (startMin - CAL_START_MIN) * (PX_PER_HOUR / 60)),
          height: Math.max(22, (endMin - startMin) * (PX_PER_HOUR / 60)),
          isNext: r.id === nextId,
        });
      }
      return {
        weekday: wd,
        label: dayName.charAt(0).toUpperCase() + dayName.slice(1),
        isToday: wd === todayWd,
        blocks,
      };
    });
  } catch (err) {
    console.error("[ir] week schedule failed:", err);
    weekDays = [];
  }
}
---

<Layout title={pageTitle}>
  {!invalid && (
    <div slot="head">
      <meta http-equiv="refresh" content="60" />
    </div>
  )}
  <main class="min-h-screen bg-background flex items-center justify-center px-4 sm:px-6 py-10 sm:py-16">
    {invalid ? (
      <section class="w-full max-w-lg text-center">
        <p class="text-sm font-medium text-muted-foreground mb-3">Mattics · Clases virtuales</p>
        <h1 class="heading-1 mb-4">Este enlace no es válido</h1>
        <p class="text-muted-foreground leading-relaxed mb-4">
          El enlace que usaste no existe o fue desactivado. Pide a tu docente un enlace nuevo
          e inténtalo de nuevo.
        </p>
        <p class="text-sm text-muted-foreground leading-relaxed mb-8">
          Aviso de privacidad (Ley 1581 de 2012): los accesos válidos registran IP, ciudad
          aproximada y navegador para controlar el acceso. Más información en nuestra{" "}
          <a href="/politica-de-privacidad" class="text-primary hover:underline font-medium">
            política de privacidad
          </a>.
        </p>

      </section>
    ) : (
      <section class="w-full max-w-5xl">
        <p class="text-sm font-medium text-muted-foreground mb-3">Mattics · Clases virtuales</p>
        <h1 class="heading-1 mb-4">Hola, {context?.studentName ?? "estudiante"}</h1>
        <p class="text-muted-foreground leading-relaxed mb-2">
          {context?.courseName
            ? `Curso ${context.courseName}: en este momento no hay una clase en vivo.`
            : "En este momento no hay una clase en vivo."}
        </p>
        <p class="text-muted-foreground leading-relaxed mb-8">
          Quédate en esta página: cuando tu clase comience, este mismo enlace te llevará
          automáticamente a la videollamada.
        </p>

        {/* Siguiente clase: sección amplia */}
        <div class="rounded-xl border border-border bg-card p-6 sm:p-8 mb-8">
          <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">Siguiente clase</p>
          {next ? (
            <div>
              <p class="text-2xl sm:text-3xl font-bold mb-2">{next.subject?.name ?? "Clase"}</p>
              <div class="flex flex-wrap gap-x-5 gap-y-1 text-muted-foreground">
                <span>
                  Día: <strong class="text-foreground capitalize">{weekdayEs(next.schedule.weekday)}</strong>
                </span>
                <span>
                  Hora: <strong class="text-foreground">{timeRange12(next.schedule.start_time, next.schedule.end_time)}</strong>
                </span>
                {nextTeacher && (
                  <span>
                    Docente: <strong class="text-foreground">{nextTeacher}</strong>
                  </span>
                )}
              </div>
            </div>
          ) : (
            <p class="text-muted-foreground">Aún no hay una próxima clase programada. Tu docente te avisará.</p>
          )}
        </div>

        {/* Horario semanal del curso (solo lectura) */}
        {weekDays.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-semibold mb-1">
              Horario de tu curso{context?.courseName ? ` · ${context.courseName}` : ""}
            </h2>
            <p class="text-sm text-muted-foreground mb-4">Asignatura, docente y franja horaria de cada sesión.</p>
            <div class="overflow-x-auto rounded-xl border border-border bg-card">
              <div class="min-w-[680px]">
                <div
                  class="grid border-b border-border bg-muted/50"
                  style={`grid-template-columns: 56px repeat(${weekDays.length}, minmax(0, 1fr))`}
                >
                  <div />
                  {weekDays.map((d) => (
                    <div class={`px-2 py-2 text-center text-sm font-semibold ${d.isToday ? "text-primary" : ""}`}>
                      {d.label}{d.isToday ? " · hoy" : ""}
                    </div>
                  ))}
                </div>
                <div
                  class="grid"
                  style={`grid-template-columns: 56px repeat(${weekDays.length}, minmax(0, 1fr))`}
                >
                  <div aria-hidden>
                    {calHours.map((h) => (
                      <div class="border-t border-border/60 pr-2 text-right text-[11px] leading-[48px] text-muted-foreground h-12">
                        {hourLabel12(h)}
                      </div>
                    ))}
                  </div>
                  {weekDays.map((d) => (
                    <div class={`relative overflow-hidden border-l border-border/60 ${d.isToday ? "bg-primary/[0.04]" : ""}`}>
                      {calHours.map((h) => (
                        <div class="block h-12 w-full border-t border-border/60" />
                      ))}
                      <div class="pointer-events-none absolute inset-0">
                        {d.blocks.map((b) => (
                          <div
                            class={`absolute overflow-hidden rounded-md border-l-4 px-1.5 py-1 ${b.isNext ? "border-primary bg-primary/10" : "border-blue-500 bg-blue-500/10"}`}
                            style={`top: ${b.top}px; height: ${b.height}px; left: 2px; right: 2px;`}
                          >
                            <span class="block truncate text-xs font-semibold leading-tight">{b.subject}</span>
                            <span class="block truncate text-[11px] leading-tight text-muted-foreground">{b.teacher}</span>
                            {b.height >= 56 && (
                              <span class="block truncate text-[11px] leading-tight text-muted-foreground">{b.time}</span>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        <aside class="rounded-xl bg-muted p-5 text-sm text-muted-foreground leading-relaxed mb-8">
          <h2 class="font-semibold text-foreground mb-1">Aviso de privacidad — Ley 1581 de 2012</h2>
          <p>
            Al abrir este enlace registramos tu dirección IP, tu ciudad aproximada
            (no usamos GPS ni tu ubicación exacta) y el navegador que usas, con la única
            finalidad de controlar el acceso a la clase virtual y proteger a los estudiantes.
            Puedes conocer más en nuestra{" "}
            <a href="/politica-de-privacidad" class="text-primary hover:underline font-medium">
              política de privacidad
            </a>.
          </p>
        </aside>


      </section>
    )}
  </main>
</Layout>
