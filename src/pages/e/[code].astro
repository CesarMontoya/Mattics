---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import EntradaActividad from "@/components/economia-6-7/EntradaActividad";
import { isValidCode, normalizeCode } from "@/lib/actividad/codigo";
import { findSessionByCode } from "@/lib/actividad/store";
import "@/styles/global.css";

const code = normalizeCode(Astro.params.code ?? "");
const session = isValidCode(code) ? await findSessionByCode(code) : null;
const cerrada = Boolean(session?.closed_at);
---

<Layout title="La tienda de la abuela · Mattics">
  <div slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />
  </div>

  {session && !cerrada ? (
    <EntradaActividad client:load code={session.code} title={session.title} />
  ) : (
    <div class="flex min-h-screen items-center justify-center bg-gradient-to-b from-amber-50 via-white to-rose-50 px-4 py-10">
      <div class="w-full max-w-md rounded-[2rem] border-2 border-amber-100 bg-white p-8 text-center shadow-[0_24px_60px_-30px_rgba(120,53,15,0.45)]">
        <p class="text-4xl">📕</p>
        <h1 class="mt-3 text-xl font-bold text-slate-900">
          {cerrada ? "Esta actividad ya cerró" : "No encontramos esa clase"}
        </h1>
        <p class="mt-2 text-sm text-slate-500">
          {cerrada
            ? "El docente cerró la actividad para esta clase. Pregúntale si pueden reabrirla."
            : "Revisa el código con tu docente. Son cinco caracteres, por ejemplo K7M2Q."}
        </p>

        <form method="GET" action="/e" class="mt-6 flex gap-2">
          <input
            name="code"
            maxlength="6"
            placeholder="Código de la clase"
            class="w-full rounded-xl border-2 border-slate-200 px-4 py-2.5 text-center font-mono text-lg uppercase tracking-[0.2em] outline-none focus:border-amber-400"
          />
          <button type="submit" class="rounded-full bg-amber-600 px-5 py-2.5 text-sm font-bold text-white">Entrar</button>
        </form>
      </div>
    </div>
  )}
</Layout>
